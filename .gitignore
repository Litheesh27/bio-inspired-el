.venv/
data/raw/*
data/sumo/*
data/results/*
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
src/*.egg-info/
.claude/settings.local.json
# osmnx's default Overpass HTTP response cache (settings.cache_folder).
cache/

!.gitkeep
!data/raw/.gitkeep
!data/sumo/.gitkeep
!data/results/.gitkeep
# Phase 8 sweep output IS tracked - it is the experimental evidence (see CLAUDE.md invariants).
# Partial/resume artifacts stay ignored.
!data/results/final_*.parquet


# Phase 9 derived stats bundle: small, cheap to regenerate, but it is the
# computed basis for docs/results/summary.md and the dashboard, so track it.
!data/results/stats_*.json
