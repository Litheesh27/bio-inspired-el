.venv/
data/raw/*
data/sumo/*
data/results/*
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
src/*.egg-info/
.claude/settings.local.json
# osmnx's default Overpass HTTP response cache (settings.cache_folder).
cache/

!.gitkeep
!data/raw/.gitkeep
!data/sumo/.gitkeep
!data/results/.gitkeep
# Phase 8 sweep output IS tracked - it is the experimental evidence (see CLAUDE.md invariants).
# Partial/resume artifacts stay ignored.
!data/results/final_*.parquet


# Phase 9 derived stats bundle: small, cheap to regenerate, but it is the
# computed basis for docs/results/summary.md and the dashboard, so track it.
!data/results/stats_*.json

# IEEE figure drafts. The PDFs are what LaTeX consumes and ARE tracked; the
# 600 dpi PNG previews and the SVGs regenerate from the same command and
# would add ~11 MB of binaries that nothing downstream reads.
figures/ieee/*.png
figures/ieee/*.svg

# Phase 9b-mech measurement records: the evidence behind a reported finding,
# same rationale as the final parquet. 2.5 MB, regenerable but slow.
!data/results/physarum_warm_mechanism.jsonl

# Paper build artifacts (derived from figures/ieee/ and the .tex sources)
docs/paper/figures/
docs/paper/bioroute_paper_overleaf.zip
docs/paper/*.pdf
docs/paper/*.aux
docs/paper/*.bbl
docs/paper/*.blg
docs/paper/*.log
docs/paper/*.out
docs/paper/*.fls
docs/paper/*.fdb_latexmk

# Reference PDFs and compiled output kept locally, not tracked
/bioroute_paper_overleaf.pdf
/IEEE_Conference_Template__2_.pdf
/bioroute_paper_overleaf__3_.pdf
/bioroute_paper_overleaf__4_.pdf
/bioroute_paper_overleaf__5_ (1).pdf
